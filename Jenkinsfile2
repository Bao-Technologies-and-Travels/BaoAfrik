        stage('Verify Deployment') {
            steps {
                echo 'Verifying deployment...'

                sshagent([env.SSH_KEY_ID]) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ${SSH_HOST} '
                        # Wait for services to start
                        sleep 10

                        echo "=== Deployment Verification ==="
                        echo "PM2 Processes:"
                        pm2 list

                        echo "Nginx Status:"
                        sudo systemctl status nginx --no-pager

                        echo "SSL Certificate:"
                        sudo certbot certificates

                        echo "Testing Frontend (HTTPS):"
                        curl -f https://${DOMAIN} > /dev/null && echo "Frontend is accessible via HTTPS" || echo "Frontend HTTPS failed"

                        echo "Testing Backend API:"
                        curl -f https://${DOMAIN}/api/health > /dev/null && echo " Backend API is accessible" || echo "Backend API failed"

                        echo "=== Deployment Complete ==="
                    '
                    """
                }
            }
        }
    }

    post {
        always {
            emailext(
                subject: "${env.JOB_NAME} - Build # ${env.BUILD_NUMBER} - ${currentBuild.currentResult}!",
                from: 'ashprincepageo@gmail.com',
                to: "${EMAIL}",
                mimeType: 'text/html',
                body: """
                    <html>
                        <body style="font-family: Arial, sans-serif; line-height: 1.5; color: #333;">
