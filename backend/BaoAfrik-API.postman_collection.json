						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"your-test-email@example.com\",\n  \"name\": \"Test User\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/test/send-email",
							"host": ["{{baseUrl}}"],
							"path": ["api", "test", "send-email"]
						}
					},
					"response": []
				}
			]
		}
