pipeline {
    agent any

    environment {
        NODE_ENV = 'staging'
        SSH_HOST = 'ubuntu@98.89.132.2'
        APP_DIR = '~/BaoAfrik/backend'
        APP_NAME = 'baoafrik'
        REPO_URL = 'https://github.com/Bao-Technologies-and-Travels/BaoAfrik.git'
        BRANCH = 'fonsah-staging'
    }

    stages {
        stage('Deploy to Server') {
            steps {
                echo "Deploying backend on server ${SSH_HOST}..."

                sshagent(['baoafrik-key']) {
                    sh """
                    ssh -o StrictHostKeyChecking=no ${SSH_HOST} '
                        if [ ! -d ~/BaoAfrik ]; then
                            git clone -b ${BRANCH} ${REPO_URL} ~/BaoAfrik
                        fi
                        cd ${APP_DIR}
                        git fetch origin ${BRANCH}
                        git reset --hard origin/${BRANCH}

                        mv .env.example .env

                        npm install
                        npm run build

                        pm2 restart ${APP_NAME} || pm2 start dist/server.js --name ${APP_NAME}
                        pm2 save
                    '
                    """
                }
            }
        }

        stage('Email Notification') {
            steps {
                mail(
                    bcc: '',
                    body: "${env.JOB_NAME} - Build # ${env.BUILD_NUMBER} - ${currentBuild.currentResult}: Check console output at ${env.BUILD_URL} to view the results. This is an auto-generated email. Do not reply.",
                    cc: '',
                    from: '',
                    replyTo: '',
                    subject: "${env.JOB_NAME} - Build # ${env.BUILD_NUMBER} - ${currentBuild.currentResult}!",
                    to: 'ashprincepageo@gmail.com'
                )
            }
        }
    }
}
