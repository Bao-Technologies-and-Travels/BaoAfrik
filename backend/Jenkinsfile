pipeline{
    agent any

    environment {
        NODE_ENV = 'staging'
        SSH_HOST = 'ubuntu@98.89.132.2'
        SSH_KEY_ID = 'baoafrik-key'
        APP_DIR = 'backend'
        APP_NAME = 'baoafrik'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'fonsah-staging',
                    url: 'https://github.com/Bao-Technologies-and-Travels/BaoAfrik.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("${env.APP_DIR}") {
                    sh 'mv .env.example .env'
                    sh 'npm install'
                }
            }
        }

        // stage('Test') {
        //     steps {
        //         dir("${env.APP_DIR}") {
        //             echo 'Running tests...'
        //             sh 'npm test  --passWithNoTests'
        //         }
        //     }
        // }

        stage('Build') {
            steps {
                dir("${env.APP_DIR}") {
                    echo 'Building the API...'
                    sh 'npm run build'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying backend to server...'

                sshagent(['baoafrik-key']) {
                    sh 'ssh ubuntu@98.89.132.2 "mkdir -p /home/ubuntu/BaoAfrik/backend"'

                    sh """
                        scp -o StrictHostKeyChecking=no -r ${APP_DIR}/dist ubuntu@98.89.132.2:/home/ubuntu/BaoAfrik/backend/
                    """

                    sh """
                        ssh -o StrictHostKeyChecking=no ubuntu@98.89.132.2 '
                            cd /home/ubuntu/BaoAfrik/backend &&
                            pm2 restart ${APP_NAME} || pm2 start dist/server.js --name ${APP_NAME} &&
                            pm2 save
                        '
                    """
                }
            }
        }

        stage('Email Notification') {
            steps {
                mail(
                    bcc: '',
                    body: "${env.JOB_NAME} - Build # ${env.BUILD_NUMBER} - ${currentBuild.currentResult}: Check console output at ${env.BUILD_URL} to view the results. This is an auto-generated email. Do not reply.",
                    cc: '',
                    from: '',
                    replyTo: '',
                    subject: "${env.JOB_NAME} - Build # ${env.BUILD_NUMBER} - ${currentBuild.currentResult}!",
                    to: 'ashprincepageo@gmail.com'
                )
            }
        }
    }
}
