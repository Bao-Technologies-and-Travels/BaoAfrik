generator client {
  provider = "prisma-client"
  output   = "../src/generated/"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  firstName                String?   @map("first_name")
  lastName                 String?   @map("last_name")
  phoneNumber              String?   @map("phone_number")
  passwordHash             String?   @map("password_hash")
  profileImage             String?   @map("profile_image")
  gender                   String?
  bio                      String?   @map("bio")
  location                 String?   @map("location")
  birthDate                DateTime? @map("birth_date")
  emailVerified            Boolean   @default(false) @map("email_verified")
  emailVerificationCode    String?   @map("email_verification_code")
  emailVerificationExpires DateTime? @map("email_verification_expires")

  passwordResetToken        String?   @map("password_reset_token")
  passwordResetTokenExpires DateTime? @map("password_reset_token_expires")
  passwordResetCode         String?   @map("password_reset_code")
  passwordResetExpires      DateTime? @map("password_reset_expires")

  provider         String? // 'local', 'google', 'facebook', 'github'
  providerId       String?   @map("provider_id")
  isActive         Boolean   @default(true) @map("is_active")
  isVerifiedSeller Boolean   @default(false) @map("is_verified_seller")
  rating           Float?    @default(0.0)
  totalSales       Int       @default(0) @map("total_sales")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  // Relations
  products                 Product[]
  productLikes             ProductLike[]
  productSaves             ProductSave[]
  sentMessages             Message[]
  refreshTokens            RefreshToken[]
  conversationParticipants ConversationParticipant[]
  sentMessageStatuses      MessageStatus[]
  notifications            Notification[]
  productRequests          ProductRequest[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Product {
  id                String        @id @default(uuid())
  sellerId          String        @map("seller_id")
  title             String
  description       String?
  price             Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  category          String
  origin            String
  location          String
  saleType          SaleType      @default(DEFAULT) @map("sale_type")
  deliveryAvailable Boolean       @default(false) @map("delivery_available")
  quantity          Int           @default(1)
  images            Json? // Array of image objects with url, isPrimary, etc.
  status            ProductStatus @default(DRAFT)
  viewCount         Int           @default(0) @map("view_count")
  likeCount         Int           @default(0) @map("like_count")
  saveCount         Int           @default(0) @map("save_count")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  publishedAt       DateTime?     @map("published_at")

  // Relations
  seller        User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  likes         ProductLike[]
  saves         ProductSave[]
  messages      Message[]
  conversations Conversation[]

  @@map("products")
}

model ProductLike {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_likes")
}

model ProductSave {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_saves")
}

model Message {
  id              String      @id @default(uuid())
  senderId        String      @map("sender_id")
  productId       String?     @map("product_id")
  conversationId  String?     @map("conversation_id")
  imageUrl        String?     @map("image_url")
  audioUrl        String?     @map("audio_url")
  fileUrl         String?     @map("file_url")
  fileName        String?     @map("file_name")
  fileSize        Int?        @map("file_size")
  replyToId       String?     @map("reply_to_id")
  productData     String?
  productSnapshot Json?       @map("product_snapshot")
  subject         String?
  isRead          Boolean     @default(false) @map("is_read")
  messageType     MessageType @default(INQUIRY) @map("message_type")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // app level encryption
  content           String @db.Text
  encryptionIv      String
  encryptionAuthTag String

  // database level encryption
  dbEncryptedContent String? @db.Text

  // metadata
  encryptedAt      DateTime @default(now())
  encryptedVersion String   @default("v1-aes256-gcm")

  // Security audit
  integrityHash  String? // Hash of original content
  tamperDetected Boolean @default(false)

  // Relations
  sender                    User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  product                   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  conversation              Conversation?   @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo                   Message?        @relation("MessageReplies", fields: [replyToId], references: [id])
  replies                   Message[]       @relation("MessageReplies")
  statuses                  MessageStatus[]
  conversationAsLastMessage Conversation[]  @relation("ConversationLastMessage")

  @@index([encryptedAt])
  @@map("messages")
}

model MessageStatus {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  status    String   @default("sent") // sent, delivered, read
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_status")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  slug        String   @unique
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique // ISO country code
  flag      String? // Flag image URL
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("countries")
}

model Conversation {
  id            String    @id @default(uuid())
  productId     String?   @map("product_id")
  lastMessageId String?   @map("last_message_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  productData   String?

  // Relations
  product      Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  lastMessage  Message?                  @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]                 @relation("ConversationMessages")

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")
  lastReadAt     DateTime @default(now()) @map("last_read_at")
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model ProductRequest {
  id             String   @id @default(uuid())
  productName    String   @map("product_name")
  description    String?
  origin         String
  sellerLocation String   @map("seller_location")
  minPrice       Float?   @map("min_price")
  maxPrice       Float?   @map("max_price")
  currency       String   @default("USD")
  status         String   @default("PENDING") // PENDING, FULFILLED, REJECTED
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("product_requests")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String // e.g., 'message', 'like', 'purchase', 'system', 'request'
  message   String?
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json? // Additional data like product ID, message preview, etc.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
}

enum MessageType {
  INQUIRY
  NEGOTIATION
  ORDER
  COMPLAINT
  GENERAL
  TEXT
  IMAGE
  AUDIO
  FILE
  SYSTEM
}

enum MessageStatusType {
  SENT
  DELIVERED
  READ
}

enum SaleType {
  DEFAULT
  URGENT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SOLD
  EXPIRED
  DELETED
}
