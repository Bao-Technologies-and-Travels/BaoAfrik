generator client {
  provider = "prisma-client"
  output   = "../src/generated/"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  firstName                String?   @map("first_name")
  lastName                 String?   @map("last_name")
  phoneNumber              String?   @map("phone_number")
  phoneCode                String?   @map("phone_code")
  passwordHash             String?   @map("password_hash")
  profileImage             String?   @map("profile_image")
  gender                   String?
  bio                      String?   @map("bio")
  location                 String?   @map("location")
  birthDate                DateTime? @map("birth_date")
  emailVerified            Boolean   @default(false) @map("email_verified")
  emailVerificationCode    String?   @map("email_verification_code")
  emailVerificationExpires DateTime? @map("email_verification_expires")

  passwordResetToken        String?   @map("password_reset_token")
  passwordResetTokenExpires DateTime? @map("password_reset_token_expires")
  passwordResetCode         String?   @map("password_reset_code")
  passwordResetExpires      DateTime? @map("password_reset_expires")

  provider          String? // 'local', 'google', 'facebook', 'github'
  providerId        String?   @map("provider_id")
  isActive          Boolean   @default(true) @map("is_active")
  isVerifiedSeller  Boolean   @default(false) @map("is_verified_seller")
  rating            Float?    @default(0.0)
  totalSales        Int       @default(0) @map("total_sales")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastLoginAt       DateTime? @map("last_login_at")
  cookiePreferences String?   @map("cookie_preferences") // 'all', 'none', 'essential', or JSON string for granular preferences

  // Relations
  products                 Product[]
  productLikes             ProductLike[]
  productSaves             ProductSave[]
  productReviews           ProductReview[]
  userReviews              UserReview[]              @relation("UserReviews")
  reviewsGiven             UserReview[]              @relation("UserReviewer")
  sentMessages             Message[]
  refreshTokens            RefreshToken[]
  conversationParticipants ConversationParticipant[]
  conversationMetadata     ConversationMetadata[]
  sentMessageStatuses      MessageStatus[]
  messageReactions         MessageReaction[]
  messageMetadata          MessageMetadata[]
  notifications            Notification[]
  productRequests          ProductRequest[]
  sessions                 Session[]
  twoFactorAuth            TwoFactorAuth?
  socialAccounts           SocialAccount[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session?

  @@map("refresh_tokens")
}

model Product {
  id                String        @id @default(uuid())
  sellerId          String        @map("seller_id")
  title             String
  slug              String?       @unique
  description       String?
  price             Decimal       @db.Decimal(10, 2)
  currency          String        @default("USD")
  category          String
  origin            String
  location          String
  // saleType          SaleType      @default(DEFAULT) @map("sale_type")
  deliveryAvailable Boolean       @default(false) @map("delivery_available")
  quantity          Int           @default(1)
  images            Json? // Array of image objects with url, isPrimary, etc.
  status            ProductStatus @default(DRAFT)
  viewCount         Int           @default(0) @map("view_count")
  likeCount         Int           @default(0) @map("like_count")
  saveCount         Int           @default(0) @map("save_count")
  engagements       Int           @default(0) @map("engagements")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  publishedAt       DateTime?     @map("published_at")
  expiresAt         DateTime?     @map("expires_at") 

  // Relations
  seller        User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  likes         ProductLike[]
  saves         ProductSave[]
  reviews       ProductReview[]
  messages      Message[]
  conversations Conversation[]

  @@map("products")
}

model ProductLike {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_likes")
}

model ProductSave {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_saves")
}

model ProductReview {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  rating    Float
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product          Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpfulnessVotes ReviewHelpfulness[]

  @@unique([productId, userId])
  @@map("product_reviews")
}

model ReviewHelpfulness {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  isHelpful Boolean  @map("is_helpful")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("review_helpfulness")
}

model UserReview {
  id         String   @id @default(uuid())
  userId     String   @map("user_id") // User being reviewed
  reviewerId String   @map("reviewer_id") // User who wrote the review
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user             User                    @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  reviewer         User                    @relation("UserReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  helpfulnessVotes UserReviewHelpfulness[]

  @@unique([userId, reviewerId])
  @@map("user_reviews")
}

model UserReviewHelpfulness {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  isHelpful Boolean  @map("is_helpful")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  review UserReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@map("user_review_helpfulness")
}

model Message {
  id              String      @id @default(uuid())
  senderId        String      @map("sender_id")
  productId       String?     @map("product_id")
  conversationId  String?     @map("conversation_id")
  imageUrl        String?     @map("image_url")
  audioUrl        String?     @map("audio_url")
  fileUrl         String?     @map("file_url")
  fileName        String?     @map("file_name")
  fileSize        Int?        @map("file_size")
  replyToId       String?     @map("reply_to_id")
  productData     String?
  productSnapshot Json?       @map("product_snapshot")
  subject         String?
  isRead          Boolean     @default(false) @map("is_read")
  messageType     MessageType @default(INQUIRY) @map("message_type")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  readAt          DateTime?

  // app level encryption
  content           String @db.Text
  encryptionIv      String
  encryptionAuthTag String

  // database level encryption
  dbEncryptedContent String? @db.Text

  // metadata
  encryptedAt      DateTime @default(now())
  encryptedVersion String   @default("v1-aes256-gcm")

  // Security audit
  integrityHash  String? // Hash of original content
  tamperDetected Boolean @default(false)

  // Relations
  sender                    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  product                   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  conversation              Conversation?     @relation("ConversationMessages", fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo                   Message?          @relation("MessageReplies", fields: [replyToId], references: [id])
  replies                   Message[]         @relation("MessageReplies")
  statuses                  MessageStatus[]
  reactions                 MessageReaction[]
  metadata                  MessageMetadata[]
  conversationAsLastMessage Conversation[]    @relation("ConversationLastMessage")

  @@index([encryptedAt])
  @@map("messages")
}

model MessageStatus {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  status    String   @default("sent") // sent, delivered, read
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_status")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  reaction  String // emoji string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_reactions")
}

model MessageMetadata {
  id             String   @id @default(uuid())
  messageId      String   @map("message_id")
  userId         String   @map("user_id")
  isPinned       Boolean  @default(false) @map("is_pinned")
  isArchived     Boolean  @default(false) @map("is_archived")
  isImportant    Boolean  @default(false) @map("is_important")
  isDeletedForMe Boolean  @default(false) @map("is_deleted_for_me")
  label          String? // label name or null
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @map("updated_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_metadata")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  slug        String   @unique
  icon        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Country {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique // ISO country code
  flag      String? // Flag image URL
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("countries")
}

model Conversation {
  id            String    @id @default(uuid())
  productId     String?   @map("product_id")
  requestId     String?   @map("request_id")
  lastMessageId String?   @map("last_message_id")
  lastMessageAt DateTime? @map("last_message_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  productData   String?

  // Relations
  product      Product?                  @relation(fields: [productId], references: [id], onDelete: SetNull)
  request      ProductRequest?           @relation(fields: [requestId], references: [id], onDelete: SetNull)
  lastMessage  Message?                  @relation("ConversationLastMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]                 @relation("ConversationMessages")
  metadata     ConversationMetadata[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")
  lastReadAt     DateTime @default(now()) @map("last_read_at")
  createdAt      DateTime @default(now())

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model ConversationMetadata {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  isPinned       Boolean  @default(false) @map("is_pinned")
  isArchived     Boolean  @default(false) @map("is_archived")
  isMuted        Boolean  @default(false) @map("is_muted")
  label          String? // label name or null
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_metadata")
}

model ProductRequest {
  id             String         @id @default(uuid())
  productName    String         @map("product_name")
  description    String?
  origin         String
  sellerLocation String         @map("seller_location")
  minPrice       Float?         @map("min_price")
  maxPrice       Float?         @map("max_price")
  currency       String         @default("USD")
  status         String         @default("PENDING") // PENDING, FULFILLED, REJECTED, ONGOING
  category       String?        // Optional category
  quantity       String?        // Optional quantity value
  quantityUnit   String?        @map("quantity_unit") // KG, L, PK, etc.
  endDate        DateTime?      @map("end_date") // Optional end date for the request
  images         Json?          // Array of image objects with url, isPrimary, etc.
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  conversations  Conversation[]

  @@map("product_requests")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String // e.g., 'message', 'like', 'purchase', 'system', 'request'
  message   String?
  isRead    Boolean  @default(false) @map("is_read")
  metadata  Json? // Additional data like product ID, message preview, etc.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
}

enum MessageType {
  INQUIRY
  NEGOTIATION
  ORDER
  COMPLAINT
  GENERAL
  TEXT
  IMAGE
  AUDIO
  FILE
  SYSTEM
}

enum MessageStatusType {
  SENT
  DELIVERED
  READ
}

enum SaleType {
  DEFAULT
  URGENT
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  SOLD
  EXPIRED
  DELETED
}

model Session {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  refreshTokenId String?   @unique @map("refresh_token_id")
  deviceName     String?   @map("device_name")
  deviceType     String?   @map("device_type") // 'desktop', 'mobile', 'tablet'
  browser        String? // Browser name (e.g., 'Chrome', 'Safari', 'Firefox')
  browserVersion String?   @map("browser_version")
  os             String? // Operating system (e.g., 'Windows', 'macOS', 'iOS', 'Android')
  osVersion      String?   @map("os_version")
  ipAddress      String?   @map("ip_address")
  location       String? // Location string (e.g., 'London, United Kingdom')
  country        String? // Country code (e.g., 'GB', 'US')
  city           String? // City name
  userAgent      String?   @map("user_agent") @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime? @map("expires_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, isActive])
  @@map("sessions")
}

model TwoFactorAuth {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  isEnabled           Boolean   @default(false) @map("is_enabled")
  method              String? // 'email', 'phone', 'app'
  phoneNumber         String?   @map("phone_number")
  phoneCode           String?   @map("phone_code") // Country code
  verificationCode    String?   @map("verification_code")
  verificationExpires DateTime? @map("verification_expires")
  backupCodes         String[]  @default([]) @map("backup_codes")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_auth")
}

model SocialAccount {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  provider       String // 'whatsapp', 'facebook', 'instagram', 'linkedin', 'x', 'google', 'apple'
  providerId     String?   @map("provider_id") // External provider user ID
  providerEmail  String?   @map("provider_email")
  providerName   String?   @map("provider_name")
  accessToken    String?   @map("access_token") @db.Text
  refreshToken   String?   @map("refresh_token") @db.Text
  tokenExpiresAt DateTime? @map("token_expires_at")
  isConnected    Boolean   @default(true) @map("is_connected")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@map("social_accounts")
}
