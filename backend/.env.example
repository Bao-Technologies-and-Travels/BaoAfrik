# Environment Configuration
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL="postgresql://username:password@host:port/database?schema=schema"
# REDIS_URL="redis://localhost:6379"

# JWT Configuration
JWT_SECRET="your_jwt_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_EXPIRE_TIME="30m"
JWT_REFRESH_EXPIRE_TIME="7d"

# Email Configuration
# EMAIL_SERVICE="smtp"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# EMAIL_FROM_ADDRESS="email_address"
# EMAIL_PASSWORD="gmail_app_password"
# EMAIL_FROM_NAME="BaoAfrik Team"

EMAIL_SERVICE="resend"
RESEND_API_KEY="your_resend_api_key_here"
EMAIL_FROM_ADDRESS="noreply@baoafrik.com"
EMAIL_FROM_NAME="BaoAfrik Team"

# File Storage Configuration
STORAGE_SERVICE="cloudinary"
# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# AWS S3 (Alternative)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="your-s3-bucket-name"
AWS_REGION="us-east-1"

# Frontend Configuration
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,https://baoafrik.com"

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging Configuration
LOG_LEVEL="info"
LOG_FILE_PATH="logs/app.log"

# Monitoring (Sentry)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"